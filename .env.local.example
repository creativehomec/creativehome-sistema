# ---------------------------------------------------------------------------
# Identidade da marca (white label). Tudo opcional — o fallback está em
# lib/brand.ts. As cores ficam em app/globals.css (variáveis --brand-*).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_BRAND_NAME=CreativeHome
NEXT_PUBLIC_BRAND_LEGAL_NAME=CreativeHome
NEXT_PUBLIC_BRAND_PRODUCT_NAME=Guia de Captação
NEXT_PUBLIC_BRAND_DESCRIPTION=Guias de gravação: roteiros, referências e checklist por projeto.
# Link de contato mostrado nos pacotes do orçamento (web e PDF).
NEXT_PUBLIC_BRAND_CONTACT_URL=
# Nome da fonte de display. Precisa bater com o @font-face de app/globals.css
# e com o arquivo public/fonts/<nome>.ttf. Vazio = fonte padrão do sistema.
NEXT_PUBLIC_BRAND_DISPLAY_FONT=

# Senha única de acesso à área administrativa (/admin)
ADMIN_PASSWORD=troque-esta-senha

# Supabase — Project Settings > API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Google (Drive das galerias + Agenda do backlog) — OAuth Client ID em
# console.cloud.google.com > APIs & Services > Credentials. Tipo "Web
# application". Ative a "Google Drive API" no projeto. Redirect URI precisa
# ser exatamente igual ao registrado no Client ID (uma entrada por ambiente).
# Ative também a "Google Calendar API" pra sincronizar o calendário do backlog.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3100/api/drive/oauth/callback

# Fuso usado ao criar os eventos do backlog no Google Agenda. Opcional —
# o padrão é America/Sao_Paulo.
# BACKLOG_TIME_ZONE=America/Sao_Paulo
